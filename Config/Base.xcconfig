// Réglages de l'app partagés par tous (versionnés).
//
// Équipe de signature et identifiant de l'app ci-dessous. Pour en utiliser d'autres sur un
// autre Mac, sans toucher à ce fichier : copie Local.xcconfig.example en Local.xcconfig (non
// versionné) et remplis-le ; ses valeurs remplacent celles-ci.
// Ne règle plus l'équipe dans Xcode (Signing & Capabilities) : Xcode modifierait le fichier
// projet, ce qui crée des conflits au pull suivant.

PRODUCT_BUNDLE_IDENTIFIER = com.zgueb.RepCounter
DEVELOPMENT_TEAM = D7HS87Z523

#include? "Local.xcconfig"
